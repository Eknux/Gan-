{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gan",
  "version": "0.2.0",
  "identifier": "com.gan.app",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm --prefix frontend run dev",
    "beforeBuildCommand": "npm --prefix frontend run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Gan",
        "width": 420,
        "height": 820,
        "minWidth": 320,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' https://api.z.ai https://*.z.ai"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "z.ai sohbet istemcisi",
    "longDescription": "Gan — z.ai (GLM) için Rust ve Tauri 2 ile yazılmış açık kaynaklı mobil sohbet istemcisi.",
    "android": {
      "minSdkVersion": 24,
      "versionCode": 2
    }
  }
}
